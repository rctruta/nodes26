# Copy to .env. Keep .env private.
NEO4J_PASSWORD=replace-with-a-local-password
NEO4J_HOST=127.0.0.1
NEO4J_IMAGE=neo4j@sha256:362542416de6c09a971484d1893878016cc3b5cdec166e54b1c824a220ecd6b9
# Four consecutive ports are used from each base, one per arm.
BASE_HTTP_PORT=54411
BASE_BOLT_PORT=54711
RESULTS_DIR=results
COMPOSE_PROJECT_PREFIX=claim-trace
LOG_LEVEL=INFO
# Required only for agent trials:
OPENAI_API_KEY=
